rules_version = '2';

// ============================================================================
// IronPulse Firestore security rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Model:
//  • A user owns everything under /users/{uid} and nobody else can read it.
//  • A team document is readable by its members and writable in ways that stop
//    one member from rewriting the whole roster.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- user --
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      // Sessions, attendance, metrics, photos, nutrition, coach thread.
      match /{collection}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------------------------------------------------------------- team --
    match /teams/{teamId} {

      function team() {
        return resource.data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in team().memberUids;
      }

      function isOwner() {
        return signedIn() && request.auth.uid == team().ownerUid;
      }

      // Anyone signed in can read a team document — that is how joining by code
      // works. Keep nothing sensitive in it beyond the stats members opt to share.
      allow read: if signedIn();

      // The creator must be the owner and the only initial member.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;

      // Members may update the team (joining, posting, updating their own stats).
      // The owner can never be reassigned by a non-owner, and a joiner may only
      // add themselves.
      allow update: if signedIn()
                    && request.resource.data.ownerUid == team().ownerUid
                    && (
                      isMember()
                      || (
                        // Joining: the roster grows by exactly this user.
                        request.resource.data.memberUids.size() == team().memberUids.size() + 1
                        && request.auth.uid in request.resource.data.memberUids
                        && team().memberUids.size() < team().maxMembers
                      )
                    );

      allow delete: if isOwner();
    }
  }
}
