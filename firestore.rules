rules_version = '2';

// ============================================================================
// IronPulse Firestore security rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Model:
//  • A user owns everything under /users/{uid} and nobody else can read it.
//    That includes sessions, measurements, photos, form checks and the push
//    devices the reminder function reads (the Admin SDK bypasses these rules).
//  • A team document is readable by any signed-in user (joining by code needs
//    it) and writable by its members, with guard rails on ownership.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------- user --
    match /users/{uid} {
      allow read, write: if isSelf(uid);

      // sessions, attendance, metrics, photos, nutrition, coach, formChecks, devices
      match /{collection}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------------------------------------------------------------- team --
    match /teams/{teamId} {

      function before() {
        return resource.data;
      }

      function after() {
        return request.resource.data;
      }

      function wasMember() {
        return request.auth.uid in before().memberUids;
      }

      function wasOwner() {
        return request.auth.uid == before().ownerUid;
      }

      allow read: if signedIn();

      // The creator must be the owner and the only initial member.
      allow create: if signedIn()
                    && after().ownerUid == request.auth.uid
                    && after().memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // Members can update the team. Ownership may only change hands when
        // the current owner does it, and the new owner must be a member.
        (
          wasMember()
          && (
            after().ownerUid == before().ownerUid
            || (wasOwner() && after().ownerUid in after().memberUids)
          )
        )
        // Joining: the roster grows by exactly this user, within the cap.
        || (
          !wasMember()
          && after().ownerUid == before().ownerUid
          && request.auth.uid in after().memberUids
          && after().memberUids.size() == before().memberUids.size() + 1
          && before().memberUids.size() < before().maxMembers
        )
      );

      // The owner can delete the team; so can the last remaining member.
      allow delete: if signedIn() && (wasOwner() || before().memberUids == [request.auth.uid]);
    }
  }
}
